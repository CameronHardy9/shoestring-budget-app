{
  "name": "@shoestring/tests",
  "version": "0.0.0",
  "private": true,
  "description": "Shoestring cross-area suites: contract, integration and security regressions against the running e2e stack (and, from Phase B, Playwright e2e and visual). Owner: test-engineer.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "e2e": "node scripts/build-prod-frontend.mjs && vitest run && playwright test",
    "visual": "playwright test -c playwright.visual.config.ts",
    "api": "vitest run",
    "ui": "playwright test",
    "test": "vitest run -c vitest.unit.config.ts",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@shoestring/db": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
