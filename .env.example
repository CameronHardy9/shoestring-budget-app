# Every environment variable the app and the local stack read, with a safe
# example value and a comment. Real values never go in the repo.
#
# Local setup: `make setup` (or the first `make dev`) creates .env (gitignored,
# mode 600) with random values for the four credentials below, plus
# SEED_USER_PASSWORD (see "Local stack"). It never overwrites an existing .env.
# docker compose reads .env for the ${VAR} values in docker-compose.yml. Add any
# other override from this file to .env by hand.
# make test and make e2e ignore .env credentials and generate fresh ones per run.

# --- Generated credentials (local only; never copy these to production) -------
# Left empty on purpose: make setup fills them in .env. Compose refuses to start
# without them. To make a password by hand: openssl rand -hex 24. If you change
# a password, run make dev-reset, because the dev database keeps the passwords
# it was created with.
# Superuser of the local Postgres container.
POSTGRES_PASSWORD=
# Password of the `app` role (used in DATABASE_URL).
APP_DB_PASSWORD=
# Password of the `migrator` role (used in MIGRATOR_DATABASE_URL).
MIGRATOR_DB_PASSWORD=
# Application keyring (docs/contracts/data-model.md): JSON of the form
#   {"current":"k1","keys":{"k1":"<32 random bytes, base64>"}}
# make setup writes it in single quotes. By hand, the key is: openssl rand -base64 32
# Production's lives in Secret Manager (sre), never here.
APP_KEYRING=

# --- Local stack (docker-compose.yml, make dev) -------------------------------
# Database name in the dev container (make test / make e2e use shoestring_test).
POSTGRES_DB=shoestring
# Host ports. Postgres and the API bind to 127.0.0.1 only.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173
# Where the frontend dev server listens on the host. make dev LAN=1 sets 0.0.0.0.
FRONTEND_BIND=127.0.0.1
# 1 = load the deterministic seed data after migrations on make dev.
SEED=1
# Optional, local only: the sign-in password of every seed user. At least 12
# characters; generate your own (openssl rand -hex 16) and never reuse a real
# password. make setup writes a random one into a NEW .env (it never edits an
# existing one; add the line by hand). Left empty, each seed user gets a random
# password nobody knows and cannot sign in. The seed runs once per dev database,
# so after setting or changing it run make dev-reset. Never set in production.
SEED_USER_PASSWORD=

# --- Database (backend, db, tests) --------------------------------------------
# Not set in .env: make dev, make test and make e2e build these URLs from the
# passwords above (role app, migrator or postgres, with that role's password)
# and pass them to the containers and test runners.
# App role: SELECT/INSERT/UPDATE/DELETE only. The only database URL in production.
DATABASE_URL=
# Migrator role: owns the schema and runs migrations (proposed name, see db/).
MIGRATOR_DATABASE_URL=
# Superuser, local and test only: bootstraps the roles above. Never set in production.
DATABASE_ADMIN_URL=

# --- Backend (docs/contracts/auth.md, test-hooks.md) --------------------------
NODE_ENV=development
# Listen address and port. The production image uses 0.0.0.0:8080.
HOST=0.0.0.0
PORT=3000
# Exact origin the browser uses; the CSRF check compares Origin to it.
APP_ORIGIN=http://localhost:5173
# false only for local http; the backend refuses false when NODE_ENV=production.
COOKIE_SECURE=false
# 1 enables /api/_test/* for e2e; the backend refuses 1 when NODE_ENV=production.
TEST_HOOKS=0
LOG_LEVEL=info
# APP_KEYRING: see "Generated credentials" above.
# Directory of the built SPA that Fastify serves at / (set by the production image).
STATIC_DIR=/app/public

# --- Build and release ---------------------------------------------------------
# Release tag (git SHA) baked into the image; Sentry events are tagged with it.
APP_RELEASE=dev
# Same value exposed to the SPA build by Vite.
VITE_APP_RELEASE=dev
# Dev server: where the frontend proxies /api (same-origin in dev).
API_PROXY_TARGET=http://localhost:3000
