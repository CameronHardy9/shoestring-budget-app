# Every environment variable the app and the local stack read, with a safe
# example value and a comment. Real values never go in the repo.
#
# Local setup: `make setup` (or the first `make dev`) creates .env (gitignored,
# mode 600) with random values for the four credentials below, plus
# SEED_USER_PASSWORD (see "Local stack"). It never overwrites an existing .env.
# docker compose reads .env for the ${VAR} values in docker-compose.yml. Add any
# other override from this file to .env by hand.
# make test and make e2e ignore .env credentials and generate fresh ones per run.

# --- Generated credentials (local only; never copy these to production) -------
# Left empty on purpose: make setup fills them in .env. Compose refuses to start
# without them. To make a password by hand: openssl rand -hex 24. If you change
# a password, run make dev-reset, because the dev database keeps the passwords
# it was created with.
# Superuser of the local Postgres container.
POSTGRES_PASSWORD=
# Password of the `app` role (used in DATABASE_URL).
APP_DB_PASSWORD=
# Password of the `migrator` role (used in MIGRATOR_DATABASE_URL).
MIGRATOR_DB_PASSWORD=
# Application keyring (docs/contracts/data-model.md): JSON of the form
#   {"current":"k1","keys":{"k1":"<32 random bytes, base64>"}}
# make setup writes it in single quotes. By hand, the key is: openssl rand -base64 32
# Production's lives in Secret Manager (sre), never here.
APP_KEYRING=

# --- Local stack (docker-compose.yml, make dev) -------------------------------
# Database name in the dev container (make test / make e2e use shoestring_test).
POSTGRES_DB=shoestring
# Host ports. Postgres and the API bind to 127.0.0.1 only.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173
# Where the frontend dev server listens on the host. make dev LAN=1 sets 0.0.0.0.
FRONTEND_BIND=127.0.0.1
# 1 = load the deterministic seed data after migrations on make dev.
SEED=1
# Optional, local only: the sign-in password of every seed user. At least 12
# characters; generate your own (openssl rand -hex 16) and never reuse a real
# password. make setup writes a random one into a NEW .env (it never edits an
# existing one; add the line by hand). Left empty, each seed user gets a random
# password nobody knows and cannot sign in. The seed runs once per dev database,
# so after setting or changing it run make dev-reset. Never set in production.
SEED_USER_PASSWORD=

# --- Database (backend, db, tests) --------------------------------------------
# Not set in .env: make dev, make test and make e2e build these URLs from the
# passwords above (role app, migrator or postgres, with that role's password)
# and pass them to the containers and test runners.
# App role: SELECT/INSERT/UPDATE/DELETE only. The only database URL of the
# service and admin jobs in production. A non-local host needs sslmode=verify-full.
DATABASE_URL=
# Migrator role: owns the schema and runs migrations (production: migrate job only).
MIGRATOR_DATABASE_URL=
# Superuser, local and test only: bootstraps the roles above and backs the test
# hooks' reset (dev entry with TEST_HOOKS=1). Never set in production.
DATABASE_ADMIN_URL=

# --- Backend (backend/src/config.ts; docs/contracts/auth.md, test-hooks.md) ---
# Source of truth: backend/src/config.ts (server) and backend/src/admin/config.ts
# (admin CLI, which reads only what each command needs). A blank value counts as
# unset. make dev sets the first block itself; the optional ones below it reach
# the dev backend when you add them to .env.
# Required: development, test or production. The production image sets
# production; the backend refuses to start without it.
NODE_ENV=development
# Listen address and port (default 127.0.0.1:3000). The production image uses 0.0.0.0:8080.
HOST=0.0.0.0
PORT=3000
# Required. Exact origin the browser uses (no trailing slash); the CSRF and Host
# checks compare against it. Must be https in production. make dev sets it.
APP_ORIGIN=http://localhost:5173
# Default true. false only for local http; refused when NODE_ENV=production.
COOKIE_SECURE=false
# 1 enables /api/_test/* in the dev entry only (localhost or *.test origins);
# refused when NODE_ENV=production. make e2e sets 1.
TEST_HOOKS=0
# fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=info
# APP_KEYRING (required): see "Generated credentials" above.
# Directory of the built SPA that Fastify serves at / (set by the production image).
# Unset locally: the Vite dev server serves the SPA.
STATIC_DIR=

# Email (auth.md, ADR-0007). console (default in development: logged, never
# sent), test (default with NODE_ENV=test: captured outbox for e2e) or provider
# (Resend; the only value allowed in production).
EMAIL_TRANSPORT=
# Provider API key: required when EMAIL_TRANSPORT=provider. A secret: production's
# lives in Secret Manager (sre). Never put a real key here or in .env.
EMAIL_API_KEY=
# Sender, e.g. "Shoestring <no-reply@mail.example.com>". Required for provider.
EMAIL_FROM=
# Emails per UTC day before low-priority mail is held (default 100). Required in production.
EMAIL_DAILY_QUOTA=
# Have I Been Pwned range check on new passwords. Default false locally and in
# tests (no network calls; the bundled list still applies), true in production,
# where false is refused.
HIBP_ENABLED=
# Sentry DSN of the API project (not a secret). Unset locally: nothing is sent.
SENTRY_DSN=
# Trusted reverse-proxy hops for the client IP (Fastify trustProxy, auth.md §14;
# 0 to 5, default 0). Required in production and at least 1 there: 1 for Cloud
# Run's front end (ADR-0007 constraint 8, pending V26). Leave unset locally.
TRUST_PROXY_HOPS=
# Passkeys (WebAuthn). The RP ID defaults to APP_ORIGIN's host and, if set, must
# equal it (the backend refuses anything else). RP name defaults to Shoestring.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=

# --- Build and release ---------------------------------------------------------
# Release tag (git SHA) baked into the image; Sentry events are tagged with it.
APP_RELEASE=dev
# Same value exposed to the SPA build by Vite.
VITE_APP_RELEASE=dev
# Dev server: where the frontend proxies /api (same-origin in dev).
API_PROXY_TARGET=http://localhost:3000
