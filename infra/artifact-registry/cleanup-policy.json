[
  {
    "name": "keep-prod-tags",
    "action": { "type": "Keep" },
    "condition": { "tagState": "TAGGED", "tagPrefixes": ["prod-"] }
  },
  {
    "name": "keep-3-most-recent-app-backup",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "packageNamePrefixes": ["app", "backup"],
      "keepCount": 3
    }
  },
  {
    "name": "keep-2-most-recent-migrate",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "packageNamePrefixes": ["migrate"], "keepCount": 2 }
  },
  {
    "name": "delete-untagged-after-1d",
    "action": { "type": "Delete" },
    "condition": { "tagState": "UNTAGGED", "olderThan": "1d" }
  },
  {
    "name": "delete-anything-after-7d",
    "action": { "type": "Delete" },
    "condition": { "tagState": "ANY", "olderThan": "7d" }
  }
]
